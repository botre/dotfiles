[Unit]
Description=Collect Nix garbage
Documentation=man:nix-collect-garbage(1)
ConditionPathExists=/nix/var/nix/profiles/default/bin/nix-collect-garbage

[Service]
Type=oneshot
# Absolute path on purpose: the systemd user manager does not read the shell
# profile that puts Nix on PATH.
ExecStart=/nix/var/nix/profiles/default/bin/nix-collect-garbage --delete-older-than 30d
# Collecting is pure disk churn and never urgent, so stay out of the way of
# whatever is actually running.
Nice=19
IOSchedulingClass=idle
