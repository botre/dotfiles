      "mcp__linear__list_users",
      "mcp__linear__list_cycles",
      "mcp__linear__list_comments",
      "mcp__linear__list_diffs",
      "mcp__linear__search_documentation",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git stash list:*)",
      "Bash(git check-ignore:*)",
      "Bash(git ls-tree:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",

      "Bash(gh pr view:*)",
