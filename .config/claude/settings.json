      "Bash(npx next:*)",

      "Bash(bunx tsc:*)",

      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go mod tidy:*)",

      "Bash(make test:*)",

      "Bash(ticktick-cli task:*)",
