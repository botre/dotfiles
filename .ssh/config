# Each Match offers its own key first. The *.pub files stay out of the repo, so
# a machine without them falls back to offering every agent key.
# IdentitiesOnly stays off for the same reason: it would turn a missing file
# into a failed login.

# Lambda Cloud instances log in as ubuntu, on a new IP each time.
Match user ubuntu
	IdentityFile ~/.ssh/lambda-cloud.pub

# Hetzner servers log in as root.
Match user root
	IdentityFile ~/.ssh/hetzner.pub

Host *
	IdentityAgent ~/.1password/agent.sock
	ForwardAgent no
