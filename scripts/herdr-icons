#!/usr/bin/env python3
"""Copies Herdr's program icons into the agents list mod, each cropped to its
artwork and centred in a square, so every icon fills its slot to the same size.
Herdr ships them with different empty margins, which made Pi look half the size
of Codex. Run it again after a Herdr update adds or changes icons.

Usage: herdr-icons [HERDR_ICON_DIR]   (default: ~/.config/herdr-app/icons)
Needs rsvg-convert, only to measure each icon's artwork.
"""

import os
import re
import struct
import subprocess
import sys
import tempfile
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MOD = ROOT / ".config/herdr-app/mods/agent-list"
OUT = MOD / "icons/programs"
# Claude Code and Codex use our own one-colour marks instead.
OWN = {"claude", "codex"}
# The rendering used to measure. Big enough that a pixel is a small error.
RENDER = 512
# The square's side is the artwork's longer side times this: about the margin of the
# line icons beside them (Lucide draws in 18 of 24), so all read the same size.
MARGIN = 1.25
# Mods that draw program icons get the same copy of the lookup (a test keeps them equal).
USERS = ["agent-list", "agent-tabs", "agent-pane", "projects", "new-menu-org", "status"]
LOOKUP = """// Generated by scripts/herdr-icons: do not edit by hand.
// Program icons cropped to their artwork, so each fills its slot to the same size,
// and Claude Code and Codex as clean one-colour marks.
const DIR = "mods/agent-list/icons";
const OWN = { claude: "#D97757", codex: "#6F7DFF" };
const CROPPED = new Set(@NAMES@);

// How to draw a program's icon: { path, tint, color }. tint draws it as a mask
// in color (or the caller's colour when color is null); otherwise as an image.
export function programIcon(p) {
  if (!p) return null;
  if (OWN[p.key]) return { path: `${DIR}/${p.key}.svg`, tint: true, color: OWN[p.key] };
  if (!p.icon) return null;
  const name = p.icon.replace(/^icons\\//, "").replace(/\\.svg$/, "");
  const path = CROPPED.has(name) ? `${DIR}/programs/${name}.svg` : p.icon;
  return { path, tint: Boolean(p.tint), color: null };
}
"""


def png_alpha_box(data):
    """The box of non-transparent pixels in an 8-bit RGBA PNG: (x0, y0, x1, y1, w, h)."""
    assert data[:8] == b"\x89PNG\r\n\x1a\n"
    pos, idat, width = 8, b"", 0
    while pos < len(data):
        length, kind = struct.unpack(">I4s", data[pos:pos + 8])
        body = data[pos + 8:pos + 8 + length]
        if kind == b"IHDR":
            width, height, depth, color = struct.unpack(">IIBB", body[:10])
            assert depth == 8 and color == 6, "expects 8-bit RGBA"
        elif kind == b"IDAT":
            idat += body
        pos += 12 + length
    raw = zlib.decompress(idat)
    stride = width * 4
    prev = bytearray(stride)
    x0, y0, x1, y1 = width, height, -1, -1
    for y in range(height):
        f = raw[y * (stride + 1)]
        line = bytearray(raw[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        for i in range(stride):
            a = line[i - 4] if i >= 4 else 0
            b = prev[i]
            c = prev[i - 4] if i >= 4 else 0
            if f == 1:
                line[i] = (line[i] + a) & 255
            elif f == 2:
                line[i] = (line[i] + b) & 255
            elif f == 3:
                line[i] = (line[i] + ((a + b) >> 1)) & 255
            elif f == 4:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        for x in range(width):
            if line[x * 4 + 3] > 24:
                x0, x1 = min(x0, x), max(x1, x)
                y0, y1 = min(y0, y), max(y1, y)
        prev = line
    return (x0, y0, x1 + 1, y1 + 1, width, height) if x1 >= 0 else None


def view_box(svg):
    m = re.search(r'viewBox="([^"]+)"', svg)
    if m:
        return [float(v) for v in m.group(1).replace(",", " ").split()]
    w = re.search(r'\bwidth="([\d.]+)', svg)
    h = re.search(r'\bheight="([\d.]+)', svg)
    return [0.0, 0.0, float(w.group(1)) if w else 24.0, float(h.group(1)) if h else 24.0]


def normalise(path):
    svg = path.read_text()
    vx, vy, vw, vh = view_box(svg)
    with tempfile.TemporaryDirectory() as tmp:
        png = Path(tmp) / "icon.png"
        # Measure at a fixed size, keeping the viewBox's own proportions.
        w = RENDER if vw >= vh else round(RENDER * vw / vh)
        h = RENDER if vh >= vw else round(RENDER * vh / vw)
        sized = re.sub(r"<svg\b[^>]*>", lambda m: re.sub(r'\s(width|height|style)="[^"]*"', "", m.group(0)), svg, count=1)
        src = Path(tmp) / "icon.svg"
        src.write_text(sized)
        subprocess.run(["rsvg-convert", "-w", str(w), "-h", str(h), "-o", str(png), str(src)], check=True)
        box = png_alpha_box(png.read_bytes())
    if not box:
        return None
    x0, y0, x1, y1, pw, ph = box
    sx, sy = vw / pw, vh / ph
    bx, by, bw, bh = vx + x0 * sx, vy + y0 * sy, (x1 - x0) * sx, (y1 - y0) * sy
    side = max(bw, bh) * MARGIN
    cx, cy = bx + bw / 2, by + bh / 2
    box_attr = f'viewBox="{cx - side / 2:.3f} {cy - side / 2:.3f} {side:.3f} {side:.3f}"'

    def root(m):
        tag = re.sub(r'\s(width|height|style|viewBox)="[^"]*"', "", m.group(0))
        # A large intrinsic size, so an image() draw rasterises sharp and scales down.
        return tag[:-1].rstrip("/").rstrip() + f' {box_attr} width="96" height="96">'

    return re.sub(r"<svg\b[^>]*>", root, svg, count=1)


def main():
    src = Path(sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/.config/herdr-app/icons"))
    OUT.mkdir(parents=True, exist_ok=True)
    for old in OUT.glob("*.svg"):
        old.unlink()
    names = []
    for path in sorted(src.glob("*.svg")):
        if path.stem in OWN:
            continue
        out = normalise(path)
        if out:
            (OUT / path.name).write_text(out)
            names.append(path.stem)
    import json
    lookup = LOOKUP.replace("@NAMES@", json.dumps(names))
    for mod in USERS:
        (ROOT / ".config/herdr-app/mods" / mod / "program-icons.js").write_text(lookup)
    print(f"{len(names)} icons written to {OUT.relative_to(ROOT)}")


if __name__ == "__main__":
    main()
