#!/usr/bin/env bash

set -e

echo "Home directory: $HOME"

if ! command -v yay &> /dev/null; then
    echo "yay is not installed. Installing yay..."
    sudo pacman -S --needed git base-devel
    git clone https://aur.archlinux.org/yay.git /tmp/yay
    cd /tmp/yay
    makepkg -si --noconfirm
    cd -
    rm -rf /tmp/yay
fi

echo "Updating system..."
yay -Syu --noconfirm

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGES_FILE="$SCRIPT_DIR/../arch-packages.txt"

if [ ! -f "$PACKAGES_FILE" ]; then
    echo "Error: $PACKAGES_FILE not found!"
    exit 1
fi

echo "Installing packages from arch-packages.txt..."

packages=()
missing=()
while IFS= read -r package; do
    if [[ -z "$package" || "$package" =~ ^[[:space:]]*# ]]; then
        continue
    fi

    package=$(echo "$package" | xargs)
    packages+=("$package")

    if yay -Qi "$package" &> /dev/null; then
        echo "$package is already installed. Skipping..."
    else
        missing+=("$package")
    fi
done < "$PACKAGES_FILE"

# One transaction, so a listed package also satisfies another's dependency.
# Installed one at a time, --noconfirm would pick yay's default provider
# instead, such as hc-bin over the listed herdr-core-bin.
if [ ${#missing[@]} -gt 0 ]; then
    echo "Installing ${missing[*]}..."
    yay -S --noconfirm "${missing[@]}"
fi

# A package that was already installed keeps the install reason pacman
# recorded, and one pulled in by something else is recorded as a dependency.
# `yay -Yc` below and any later `-Rs` removal treat such a package as an
# orphan and remove it, even though this file lists it. Marking every listed
# package as explicit prevents that. `pacman -D` only takes real package names,
# so `pacman -Qq` first resolves names like procps to procps-ng.
echo "Marking listed packages as explicitly installed..."
mapfile -t installed < <(pacman -Qq "${packages[@]}" | sort -u)
sudo pacman -D -q --asexplicit "${installed[@]}"

echo "Cleaning up..."
yay -Yc --noconfirm

echo "Done"
