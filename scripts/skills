#!/usr/bin/env bash

set -e

# The skills CLI installs copies and agent-specific symlinks outside this repo.
# Keep all upstreams in skills.txt so a reinstall restores the full set.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCES_FILE="$SCRIPT_DIR/../skills.txt"

if ! command -v skills &> /dev/null; then
    echo "Error: skills is not installed!"
    echo "It comes from mise as npm:skills, so run 'mise install' first."
    exit 1
fi

if [ ! -f "$SOURCES_FILE" ]; then
    echo "Error: $SOURCES_FILE not found!"
    exit 1
fi

while IFS= read -r source; do
    if [[ -z "$source" || "$source" =~ ^[[:space:]]*# ]]; then
        continue
    fi

    source=$(echo "$source" | xargs)

    # Redirect stdin so the CLI cannot consume the remaining source lines.
    echo "Installing $source..."
    skills add "$source" --global --yes --skill '*' < /dev/null
done < "$SOURCES_FILE"

echo "Done"
