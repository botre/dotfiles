#!/usr/bin/env python3
"""Start Codex with Herdr's terminal identity and current palette."""

import json
import os
from pathlib import Path
import re
import shutil
import sys


def seed_palette(stream=sys.stdout):
    if not os.environ.get("HC_TERMINAL_ID") or not stream.isatty():
        return
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    try:
        colors = json.loads((cache / "herdr-terminal-palette.json").read_text())
        if not isinstance(colors, dict):
            return
        foreground, background = colors.get("foreground"), colors.get("background")
        if not all(isinstance(color, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", color) for color in [foreground, background]):
            return
        stream.write(f"\033]10;{foreground}\007\033]11;{background}\007")
        stream.flush()
    except (OSError, ValueError):
        return


def main():
    executable = shutil.which("codex")
    if not executable:
        print("herdr-codex: codex is not installed", file=sys.stderr)
        return 127
    args = sys.argv[1:]
    if os.environ.get("HC_TERMINAL_ID"):
        seed_palette()
        if "--no-daemon" not in args:
            args = ["--no-daemon", *args]
    os.execv(executable, [executable, *args])


if __name__ == "__main__":
    sys.exit(main())
