#!/usr/bin/env bash

set -e

# MCP configs stay untracked: they contain machine-local state or are written
# by this script and the agents themselves.
# Remote entries are added only when missing to preserve OAuth logins and avoid
# browser login prompts. For new Codex entries, run `codex mcp login` separately.
# Removed declarations are not pruned; unregister those servers by hand. The
# same goes for OpenCode rules whose Claude Code allow entry was removed.

if ! command -v mise &> /dev/null; then
    echo "Error: mise is not installed!"
    exit 1
fi

if ! command -v jq &> /dev/null; then
    echo "Error: jq is not installed!"
    exit 1
fi

has_claude=false
if command -v claude &> /dev/null; then
    has_claude=true
fi

has_opencode=false
if command -v opencode &> /dev/null; then
    has_opencode=true
fi

has_codex=false
if command -v codex &> /dev/null; then
    has_codex=true
fi

if ! $has_claude && ! $has_opencode && ! $has_codex; then
    echo "Error: none of claude, opencode and codex is installed!"
    exit 1
fi

# The allow list in Claude Code's tracked settings.json is the only list of
# commands and MCP tools that run without asking. OpenCode and Codex get rules
# derived from it.
CLAUDE_SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"

if [ ! -f "$CLAUDE_SETTINGS" ]; then
    echo "Error: $CLAUDE_SETTINGS does not exist!"
    exit 1
fi

# claude_allows <entry>
claude_allows() {
    jq -e --arg entry "$1" 'any(.permissions.allow[]?; . == $entry)' "$CLAUDE_SETTINGS" > /dev/null
}

OPENCODE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
OPENCODE_CONFIG="$OPENCODE_DIR/opencode.json"

if $has_opencode && [ -f "$OPENCODE_DIR/opencode.jsonc" ]; then
    echo "Error: $OPENCODE_DIR/opencode.jsonc exists, and jq cannot edit JSONC!"
    echo "Move its settings into $OPENCODE_CONFIG first."
    exit 1
fi

# opencode_edit <jq filter> [jq options...]
# Copy back with cat to preserve the config's mode; mktemp files are 0600.
opencode_edit() {
    local filter="$1" tmp
    shift

    mkdir -p "$OPENCODE_DIR"
    if [ ! -f "$OPENCODE_CONFIG" ]; then
        echo '{"$schema": "https://opencode.ai/config.json"}' > "$OPENCODE_CONFIG"
    fi

    tmp=$(mktemp)
    jq "$@" "$filter" "$OPENCODE_CONFIG" > "$tmp"
    cat "$tmp" > "$OPENCODE_CONFIG"
    rm "$tmp"
}

# opencode_server <name> <json>
opencode_server() {
    opencode_edit '.mcp.servers[$name] = $server' --arg name "$1" --argjson server "$2"
}

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
CODEX_CONFIG="$CODEX_DIR/config.toml"

# codex_server <name> <toml line>...
# `codex mcp add` has no tool approval option, so append the table ourselves.
# jq emits strings and arrays that are also valid TOML.
codex_server() {
    local name="$1"
    shift

    mkdir -p "$CODEX_DIR"
    codex mcp remove "$name" > /dev/null
    {
        printf '\n[mcp_servers.%s]\n' "$name"
        printf '%s\n' "$@"
    } >> "$CODEX_CONFIG"
}

# wants <agent> [agent...]
# True when no agents are listed, or when <agent> is one of them.
wants() {
    local agent="$1" listed
    shift

    if [ $# -eq 0 ]; then
        return 0
    fi

    for listed in "$@"; do
        if [ "$listed" = "$agent" ]; then
            return 0
        fi
    done

    return 1
}

# local_server <name> -- <command> [args...]
local_server() {
    local name="$1"
    shift 2

    echo "Registering $name..."

    if $has_claude; then
        claude mcp remove --scope user "$name" &> /dev/null || true
        claude mcp add --scope user "$name" -- "$@"
    fi

    # The -- after --args is required. Without it, jq drops the first -- it
    # finds among the arguments, which breaks `mise exec node@24 -- npx ...`.
    if $has_opencode; then
        opencode_server "$name" \
            "$(jq -n '{type: "local", command: $ARGS.positional}' --args -- "$@")"
    fi

    # Codex starts a server with only a short allowlist of environment
    # variables (HOME, PATH, USER and a few more), where Claude Code and
    # OpenCode pass everything. Chrome then finds no desktop session and fails
    # with "Missing X server", so env_vars forwards the display variables.
    # Codex has no rule for a whole server, so an mcp__<name>__* allow entry
    # becomes the server's approval mode here.
    if $has_codex; then
        local lines=(
            "command = $(jq -n --arg command "$1" '$command')"
            "args = $(jq -cn '$ARGS.positional' --args -- "${@:2}")"
            'env_vars = ["DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "XDG_RUNTIME_DIR"]'
        )
        if claude_allows "mcp__${name}__*"; then
            lines+=('default_tools_approval_mode = "approve"')
        fi
        codex_server "$name" "${lines[@]}"
    fi
}

# remote_server <name> <url> [agent...]
# With agents listed, only those agents get the server.
remote_server() {
    local name="$1" url="$2"
    shift 2

    echo "Registering $name..."

    if $has_claude && wants claude "$@"; then
        if claude mcp get "$name" &> /dev/null; then
            echo "$name is already registered with Claude Code. Skipping..."
        else
            claude mcp add --scope user --transport http "$name" "$url"
        fi
    fi

    if $has_opencode && wants opencode "$@"; then
        opencode_server "$name" \
            "$(jq -n --arg url "$url" '{type: "remote", url: $url}')"
    fi

    if $has_codex && wants codex "$@"; then
        if codex mcp get "$name" &> /dev/null; then
            echo "$name is already registered with Codex. Skipping..."
        else
            codex_server "$name" "url = $(jq -n --arg url "$url" '$url')"
        fi
    fi
}

# Isolated profiles prevent concurrent browser sessions from conflicting.
local_server chrome-devtools -- mise exec node@24 -- npx -y chrome-devtools-mcp@latest --isolated

# --autoConnect attaches to the Chrome already running with your own profile
# instead. It needs Chrome 144+ with remote debugging turned on at
# chrome://inspect/#remote-debugging.
local_server chrome-live -- mise exec node@24 -- npx -y chrome-devtools-mcp@latest --autoConnect

# Figma's remote server only accepts clients listed in its MCP catalog and
# rejects the rest with a 403 at client registration. Claude Code and Codex are
# listed and OpenCode is not, so check the catalog before adding an agent here.
# Log in once with /mcp in Claude Code and with `codex mcp login figma`.
remote_server figma https://mcp.figma.com/mcp claude codex

# Bash(<command>:*) and Bash(<command> *) allow <command> with any arguments,
# Bash(<command>) allows it exactly, and mcp__<server>__<tool> allows one tool,
# or every tool of the server with *. Other entries have no counterpart here.
# OpenCode uses the last rule that matches, so these follow its ask rules.
if $has_opencode; then
    echo "Copying Claude Code's allow list to OpenCode..."
    opencode_edit '
        .permissions = ((.permissions // []) as $have | $have + ($rules - $have))
    ' --argjson rules "$(jq -c '[
        .permissions.allow[]?
        | if test("^Bash\\(.+\\)$") then
            {action: "shell", resource: (.[5:-1] | sub(":\\*$"; " *"))}
        elif startswith("mcp__") then
            {action: (ltrimstr("mcp__") | sub("__"; "_")), resource: "*"}
        else
            empty
        end
        | . + {effect: "allow"}
    ]' "$CLAUDE_SETTINGS")"
fi

# Codex rules match command prefixes only, so an exact Bash entry also allows
# extra arguments there, and an entry with * anywhere else is skipped.
# The file is rewritten on every run, so removed entries disappear.
# An allowed command runs outside Codex's sandbox, as it does in Claude Code.
if $has_codex; then
    echo "Copying Claude Code's allow list to Codex..."
    mkdir -p "$CODEX_DIR/rules"
    {
        echo "# Written by scripts/agents from $CLAUDE_SETTINGS. Edits are overwritten."
        jq -r '
            .permissions.allow[]?
            | select(test("^Bash\\(.+\\)$"))
            | .[5:-1] | sub("(:| )\\*$"; "") | split(" ") | map(select(. != ""))
            | select(all(.[]; contains("*") | not))
            | "prefix_rule(pattern = \(tojson), decision = \"allow\")"
        ' "$CLAUDE_SETTINGS"
    } > "$CODEX_DIR/rules/claude-allow.rules"
fi

# Claude-synced skills reference tools OpenCode lacks. Disable the compatibility
# plugin and restore the shared skill paths it also provided.
# The project path resolves from OpenCode's startup directory, not the repo root.
if $has_opencode; then
    echo "Switching off OpenCode's Claude compatibility..."
    opencode_edit '
        .plugins = ((.plugins // []) | if any(.[]; . == $plugin) then . else . + [$plugin] end)
        | .skills = ((.skills // []) as $have | $have + ($skills - $have))
    ' --arg plugin "-opencode.config.compatibility" \
        --argjson skills '["~/.agents/skills", ".agents/skills"]'
fi

# herdr overwrites its hooks and plugins on updates, so they stay untracked.
# Its Claude SessionStart hook adds a machine-specific path to the live settings.
# After OpenCode V1, start V2 once to import preferences, then rerun this script.
# Codex needs ~/.codex to exist before the integration installs its hooks.
if command -v herdr &> /dev/null; then
    if $has_claude; then
        echo "Installing the herdr integration for Claude Code..."
        herdr integration install claude
    fi

    if $has_opencode; then
        echo "Installing the herdr integration for OpenCode..."
        herdr integration install opencode
    fi

    if $has_codex; then
        echo "Installing the herdr integration for Codex..."
        herdr integration install codex
    fi
fi

echo "Done"
