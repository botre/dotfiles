#!/usr/bin/env bash

set -e

# Registers MCP servers with Claude Code, OpenCode and Codex, whichever are
# installed, then installs herdr's integration for each of them, so a fresh
# machine ends up with the same setup in all of them.
#
# None of the server lists is tracked in this repo. Claude Code keeps its
# servers in ~/.claude.json, which also holds machine-local state (account,
# session history, caches). OpenCode keeps them in opencode.json, which this
# script writes, so tracking that file would fight the script. Codex keeps them
# in ~/.codex/config.toml, which this script, herdr and Codex itself all write
# (Codex records project trust, notices and model choices there).
#
# Re-running it is safe. For Claude Code and Codex, every local server is
# removed before it is re-added, and remote servers are only added when missing.
# Removing a remote server from Claude Code also deletes its OAuth login. Codex
# keeps the login, but adding a remote server with `codex mcp add` starts a
# browser login, so the script writes the entry itself and leaves the login to
# `codex mcp login`. For OpenCode, every server entry is overwritten in place;
# OpenCode stores OAuth logins outside its config, so that never logs anything
# out. Servers are never pruned: deleting a declaration below leaves the server
# registered until it is removed by hand.
#
# A remote server can be limited to named agents, for services that only accept
# some clients. The script also stops OpenCode from reading Claude Code's
# skills; the section near the bottom explains why.
#
# To support another agent, add a branch for it to local_server and
# remote_server, install its herdr integration at the bottom, and symlink its
# global instructions file to ~/.agents/AGENTS.md in this repo.

if ! command -v mise &> /dev/null; then
    echo "Error: mise is not installed!"
    exit 1
fi

if ! command -v jq &> /dev/null; then
    echo "Error: jq is not installed!"
    exit 1
fi

has_claude=false
if command -v claude &> /dev/null; then
    has_claude=true
fi

has_opencode=false
if command -v opencode &> /dev/null; then
    has_opencode=true
fi

has_codex=false
if command -v codex &> /dev/null; then
    has_codex=true
fi

if ! $has_claude && ! $has_opencode && ! $has_codex; then
    echo "Error: none of claude, opencode and codex is installed!"
    exit 1
fi

OPENCODE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
OPENCODE_CONFIG="$OPENCODE_DIR/opencode.json"

if $has_opencode && [ -f "$OPENCODE_DIR/opencode.jsonc" ]; then
    echo "Error: $OPENCODE_DIR/opencode.jsonc exists, and jq cannot edit JSONC!"
    echo "Move its settings into $OPENCODE_CONFIG first."
    exit 1
fi

# opencode_edit <jq filter> [jq options...]
# Applies a jq filter to OpenCode's global config, creating the file if needed.
# The result is copied back with cat rather than mv, so the file keeps its mode
# instead of taking the temporary file's 0600.
opencode_edit() {
    local filter="$1" tmp
    shift

    mkdir -p "$OPENCODE_DIR"
    if [ ! -f "$OPENCODE_CONFIG" ]; then
        echo '{"$schema": "https://opencode.ai/config.json"}' > "$OPENCODE_CONFIG"
    fi

    tmp=$(mktemp)
    jq "$@" "$filter" "$OPENCODE_CONFIG" > "$tmp"
    cat "$tmp" > "$OPENCODE_CONFIG"
    rm "$tmp"
}

# opencode_server <name> <json>
# Writes one server into OpenCode's global config.
opencode_server() {
    opencode_edit '.mcp.servers[$name] = $server' --arg name "$1" --argjson server "$2"
}

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
CODEX_CONFIG="$CODEX_DIR/config.toml"

# codex_server <name> <toml line>...
# Writes one server into Codex's global config. `codex mcp add` rewrites the
# whole entry and has no option for tool approval, so Codex's own command
# removes the old entry and the new one is appended as a TOML table. jq prints
# the values, because a JSON string, or an array of them, is also valid TOML.
codex_server() {
    local name="$1"
    shift

    mkdir -p "$CODEX_DIR"
    codex mcp remove "$name" > /dev/null
    {
        printf '\n[mcp_servers.%s]\n' "$name"
        printf '%s\n' "$@"
    } >> "$CODEX_CONFIG"
}

# wants <agent> [agent...]
# True when no agents are listed, or when <agent> is one of them.
wants() {
    local agent="$1" listed
    shift

    if [ $# -eq 0 ]; then
        return 0
    fi

    for listed in "$@"; do
        if [ "$listed" = "$agent" ]; then
            return 0
        fi
    done

    return 1
}

# local_server <name> [approve] -- <command> [args...]
# With approve, OpenCode and Codex run every tool of the server without asking.
# Claude Code takes the same rule from an mcp__<name>__* entry in the allow list
# of its tracked settings.json, so add one there as well.
local_server() {
    local name="$1" approve=false
    shift

    if [ "$1" = approve ]; then
        approve=true
        shift
    fi
    shift

    echo "Registering $name..."

    if $has_claude; then
        claude mcp remove --scope user "$name" &> /dev/null || true
        claude mcp add --scope user "$name" -- "$@"
    fi

    # The -- after --args is required. Without it, jq drops the first -- it
    # finds among the arguments, which breaks `mise exec node@24 -- npx ...`.
    if $has_opencode; then
        opencode_server "$name" \
            "$(jq -n '{type: "local", command: $ARGS.positional}' --args -- "$@")"

        if $approve; then
            opencode_edit '
                {action: $action, resource: "*", effect: "allow"} as $rule
                | .permissions = ((.permissions // []) | if any(.[]; . == $rule) then . else . + [$rule] end)
            ' --arg action "${name}_*"
        fi
    fi

    if $has_codex; then
        local lines=(
            "command = $(jq -n --arg command "$1" '$command')"
            "args = $(jq -cn '$ARGS.positional' --args -- "${@:2}")"
        )
        if $approve; then
            lines+=('default_tools_approval_mode = "approve"')
        fi
        codex_server "$name" "${lines[@]}"
    fi
}

# remote_server <name> <url> [agent...]
# With agents listed, only those agents get the server.
remote_server() {
    local name="$1" url="$2"
    shift 2

    echo "Registering $name..."

    if $has_claude && wants claude "$@"; then
        if claude mcp get "$name" &> /dev/null; then
            echo "$name is already registered with Claude Code. Skipping..."
        else
            claude mcp add --scope user --transport http "$name" "$url"
        fi
    fi

    if $has_opencode && wants opencode "$@"; then
        opencode_server "$name" \
            "$(jq -n --arg url "$url" '{type: "remote", url: $url}')"
    fi

    if $has_codex && wants codex "$@"; then
        if codex mcp get "$name" &> /dev/null; then
            echo "$name is already registered with Codex. Skipping..."
        else
            codex_server "$name" "url = $(jq -n --arg url "$url" '$url')"
        fi
    fi
}

# chrome-devtools
# --isolated gives every session its own temporary Chrome profile, so
# concurrent sessions do not fight over a shared one. Claude Code's
# settings.json allows every chrome-devtools tool without asking, and approve
# gives OpenCode and Codex the same rule, so browsing does not stop for approval.
local_server chrome-devtools approve -- mise exec node@24 -- npx -y chrome-devtools-mcp@latest --isolated

# chrome-live
# --autoConnect attaches to the Chrome already running with your own profile
# instead. It needs Chrome 144+ with remote debugging turned on at
# chrome://inspect/#remote-debugging.
local_server chrome-live -- mise exec node@24 -- npx -y chrome-devtools-mcp@latest --autoConnect

# figma
# Figma's remote server only accepts clients listed in its MCP catalog and
# rejects the rest with a 403 at client registration. Claude Code and Codex are
# listed and OpenCode is not, so check the catalog before adding an agent here.
# Log in once with /mcp in Claude Code and with `codex mcp login figma`.
remote_server figma https://mcp.figma.com/mcp claude codex

# OpenCode's Claude compatibility
# OpenCode V2 reads Claude Code's files through one built-in plugin,
# opencode.config.compatibility, which loads every skill under ~/.claude/skills.
# That includes the skills Claude Code syncs from claude.ai, which drive tools
# only Claude has (its browser extension, desktop control, artifacts), and
# OpenCode follows them into dead ends. The plugin is switched off here. It also
# loaded ~/.agents/skills and each project's .agents/skills, so both are listed
# again explicitly. The project entry resolves from the directory OpenCode
# starts in, so a project's skills load only when OpenCode starts in the
# directory that holds its .agents/skills, not in a subdirectory of it.
if $has_opencode; then
    echo "Switching off OpenCode's Claude compatibility..."
    opencode_edit '
        .plugins = ((.plugins // []) | if any(.[]; . == $plugin) then . else . + [$plugin] end)
        | .skills = ((.skills // []) as $have | $have + ($skills - $have))
    ' --arg plugin "-opencode.config.compatibility" \
        --argjson skills '["~/.agents/skills", ".agents/skills"]'
fi

# herdr integrations
# herdr reports each agent's state to its pane through a hook or plugin that it
# writes itself and overwrites on every update, so those files are not tracked
# here either. For Claude Code it also adds its own SessionStart entry to
# ~/.claude/settings.json, with this machine's absolute path in it, so the
# tracked settings.json leaves that entry out and the live copy carries it as a
# local change. On a machine that ran OpenCode V1, herdr waits for OpenCode V2
# to import the old terminal preferences before it registers its V2 plugin, so
# start opencode once and then run this script again. For Codex, herdr needs
# ~/.codex to exist, which codex_server has made sure of by now, and it turns
# on Codex's hooks feature in config.toml.
if command -v herdr &> /dev/null; then
    if $has_claude; then
        echo "Installing the herdr integration for Claude Code..."
        herdr integration install claude
    fi

    if $has_opencode; then
        echo "Installing the herdr integration for OpenCode..."
        herdr integration install opencode
    fi

    if $has_codex; then
        echo "Installing the herdr integration for Codex..."
        herdr integration install codex
    fi
fi

echo "Done"
